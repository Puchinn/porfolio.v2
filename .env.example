# URL pública del sitio (se usa para metadata, sitemap y JSON-LD)
NEXT_PUBLIC_SITE_URL=https://estebansayago.dev.ar

# Formulario de contacto (Resend)
# 1. Creá una API key en https://resend.com/api-keys
# 2. Verificá el dominio en https://resend.com/domains y usalo en CONTACT_FROM_EMAIL
RESEND_API_KEY=
CONTACT_TO_EMAIL=estebansayagodev@gmail.com
CONTACT_FROM_EMAIL=Esteban Sayago <hola@estebansayago.dev.ar>

# Opcionales
# Número con código de país, sin + ni espacios. Ej: 5491122334455
NEXT_PUBLIC_WHATSAPP=
# Link de agenda (Cal.com, Calendly). Si está vacío, el CTA lleva al formulario.
NEXT_PUBLIC_CAL_URL=
